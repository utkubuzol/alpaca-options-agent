# ---- Supabase (project: alpaca-options-saas) ----
SUPABASE_URL=https://vcfveqjvsuhgfgtkpkhw.supabase.co
# Service-role key: Supabase dashboard -> Project Settings -> API -> service_role.
# Bypasses RLS — backend only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only needed if the project uses the legacy HS256 JWT secret instead
# of asymmetric signing keys. Dashboard -> Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=

# ---- App crypto ----
# Fernet key for encrypting Alpaca keys / bot tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# ---- Telegram ----
# Platform bot from @BotFather. Users can override with their own token.
TELEGRAM_BOT_TOKEN=

# ---- CORS ----
FRONTEND_ORIGINS=http://localhost:3000

# ---- Public landing page ----
# The account whose journal + broker feed /api/public/showcase and
# /api/public/quotes (no auth). Use your demo/showcase user's UUID.
SHOWCASE_USER_ID=
