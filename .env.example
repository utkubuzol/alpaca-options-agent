# === Alpaca credentials (PAPER trading keys only — never put live keys here) ===
# Get free paper-trading keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER_TRADE=true

# === Strategy universe ===
# Comma-separated list of liquid, optionable underlyings the agent is allowed to trade.
AGENT_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA

# === Risk limits (all overridable; see risk/risk_manager.py for full list) ===
RISK_MAX_RISK_PER_TRADE_PCT=0.02
RISK_MAX_PORTFOLIO_DELTA=0.30
RISK_MAX_CONCURRENT_POSITIONS=6
RISK_MAX_DAILY_DRAWDOWN_PCT=0.03
RISK_MIN_OPEN_INTEREST=50
RISK_MAX_BID_ASK_SPREAD_PCT=0.15

# === Execution ===
EXEC_LIMIT_PRICE_IMPROVEMENT_TICKS=1
EXEC_MAX_SLIPPAGE_BPS=50
EXEC_ORDER_TIMEOUT_SECONDS=45

# === Optional: path to the Alpaca CLI binary (installed separately: `brew install alpacahq/tap/cli`
# or `go install github.com/alpacahq/cli/cmd/alpaca@latest`). Leave blank to auto-detect on PATH.
ALPACA_CLI_PATH=alpaca

# === Logging ===
AGENT_LOG_DIR=./logs
